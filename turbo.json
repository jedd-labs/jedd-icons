{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["icons/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**"]
    },
    "gen": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/build-icons/**"],
      "outputs": ["src/icons/**", "src/icons-*/**", "src/fill.ts"]
    },
    "typecheck": {
      "dependsOn": ["^build", "gen"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/build-icons/**"]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
