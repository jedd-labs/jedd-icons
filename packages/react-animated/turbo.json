{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/build-icons/**",
        "$TURBO_ROOT$/animations/**"
      ]
    },
    "gen": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/build-icons/**",
        "$TURBO_ROOT$/animations/**"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/build-icons/**",
        "$TURBO_ROOT$/animations/**"
      ]
    }
  }
}
